{
    "mcpServers": {
        "shadcn": {
            "command": "npx",
            "args": ["shadcn@latest", "mcp"]
        },
        "next-devtools": {
            "command": "npx",
            "args": ["-y", "next-devtools-mcp@latest"]
        },
        "cloudflare-docs": {
            "command": "npx",
            "args": ["mcp-remote", "https://docs.mcp.cloudflare.com/sse"]
        }
    }
}
